# --- infrastructure ---
DATABASE_URL=postgresql+psycopg://agentnet:agentnet@localhost:5432/agentnet
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=agentnet
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# --- embeddings: local (offline lexical, default) | ollama | openai ---
EMBEDDING_PROVIDER=local
# Must match the model's output size and be set BEFORE running migrations (pgvector column is fixed-width).
# local=384, ollama nomic-embed-text=768, openai text-embedding-3-small=1536
EMBEDDING_DIM=384
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=

# --- reranker: local (default) | ollama | http (Cohere/Jina-style /rerank) ---
RERANKER_PROVIDER=local
RERANKER_MODEL=llama3.1:8b
RERANKER_BASE_URL=http://127.0.0.1:11434
RERANKER_API_KEY=

# --- routing ---
VECTOR_TOP_K=50
RERANK_TOP_N=10
MIN_SIMILARITY=0.12
MIN_RERANK_SCORE=0.20

# --- webhooks ---
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_SECONDS=10,30,120,600
# DEV ONLY: permits http:// and localhost/private-IP webhook targets (disables the SSRF guard). Keep false in production.
ALLOW_PRIVATE_WEBHOOKS=true

# --- limits ---
RATE_LIMIT_PER_MINUTE=120
REGISTER_RATE_LIMIT_PER_HOUR=20
