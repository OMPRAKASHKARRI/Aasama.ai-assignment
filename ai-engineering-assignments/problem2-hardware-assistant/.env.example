# All optional. Defaults shown.
HWASSIST_OLLAMA_HOST=http://127.0.0.1:11434
HWASSIST_MODEL=llama3.1:8b
HWASSIST_LLM_TIMEOUT_SECONDS=180
HWASSIST_TEMPERATURE=0.1
HWASSIST_MAX_TOOL_STEPS=6
HWASSIST_HISTORY_TURNS=8
# Privacy guard: set true ONLY if you deliberately want to use a non-loopback LLM server.
HWASSIST_ALLOW_REMOTE_LLM=false
